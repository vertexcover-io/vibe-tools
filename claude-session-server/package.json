{
  "name": "agentwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo: WS/REST server + wire protocol + browser client SDK exposing pi AgentSessions backed by the host Claude subscription",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "serve": "tsx apps/server/src/bin.ts serve",
    "init": "tsx apps/server/src/bin.ts init",
    "chat": "tsx apps/chat/src/chat.ts",
    "web": "tsx apps/web/src/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
