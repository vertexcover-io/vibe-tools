# Copy to .env (in this folder) and fill in. The server loads it on start;
# variables already set in the shell take precedence.

# Required: Notion integration token (shared with your hiring database)
NOTION_TOKEN=

# Required: the Notion data source ID of your hiring pipeline database
NOTION_DATA_SOURCE_ID=

# Which Position to triage (matches the "Position" select property)
POSITION=AI Engineer

# Used in the rejection email
COMPANY_NAME=
SENDER_NAME=

# Gmail, for sending rejection emails. Needs a Google OAuth client of type
# "Desktop app" with the Gmail API enabled. Then run `npm run auth` once to
# fill in GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional From header, e.g. Sam <sam@example.com> (default: the signed-in account)
GMAIL_FROM=

# Custom rejection email: first line "Subject: ...", blank line, then the body.
# Placeholders: {first} {name} {position} {company} {sender}
REJECT_TEMPLATE=

# Where accept/maybe/reject/delete decisions are logged (default: decisions.jsonl here)
DECISIONS_FILE=

PORT=3737
